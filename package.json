{
  "name": "showhome-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/cli/migrate.ts",
    "discover": "tsx src/cli/discover.ts",
    "crawl:test": "tsx src/cli/discover.ts --fixture",
    "crawl": "tsx src/cli/crawl.ts",
    "results:persist": "tsx src/cli/persist-results.ts",
    "results:classify-stream": "tsx src/cli/classify-stream.ts",
    "results:classify": "tsx src/cli/classify-results.ts",
    "results:repair": "tsx src/cli/repair-coverage.ts",
    "results:publish": "tsx src/cli/publish-collection.ts",
    "results:reports": "tsx src/cli/reports.ts",
    "sites:sync": "tsx src/cli/sync-site-filtering.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "build:crawler": "tsc -p tsconfig.crawler.json"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.5",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
