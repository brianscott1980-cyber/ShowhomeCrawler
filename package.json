{
  "name": "showhome-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/cli/migrate.ts",
    "discover": "tsx src/cli/discover.ts",
    "crawl:test": "tsx src/cli/discover.ts --fixture",
    "crawl": "tsx src/cli/crawl.ts",
    "results:persist": "tsx src/cli/persist-results.ts",
    "results:classify-stream": "tsx src/cli/classify-stream.ts",
    "results:classify": "tsx src/cli/classify-results.ts",
    "results:repair": "tsx src/cli/repair-coverage.ts",
    "results:publish": "tsx src/cli/publish-collection.ts",
    "results:reports": "tsx src/cli/reports.ts",
    "images:categorise": "tsx src/cli/categorise-all.ts",
    "sites:sync": "tsx src/cli/sync-site-filtering.ts",
    "locations:geography": "tsx src/cli/location-geography.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "build:crawler": "tsc -p tsconfig.crawler.json",
    "images:normalise-bedrooms": "tsx src/cli/normalise-bedrooms.ts",
    "predev": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "builders:ratings:sync": "tsx src/cli/sync-builder-ratings.ts",
    "builders:ratings:crawl": "tsx src/cli/crawl-builder-ratings.ts",
    "storage:status": "python3 scripts/nas-storage.py",
    "storage:connect": "python3 scripts/nas-storage.py --auto-mount",
    "website:import": "tsx src/cli/import-website.ts",
    "website:publish": "tsx src/cli/publish-website.ts",
    "ai:local:setup": "tsx src/cli/local-ai-setup.ts",
    "ai:local:sample": "tsx src/cli/classify-local.ts --sample",
    "ai:local": "tsx src/cli/classify-local.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.5",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
